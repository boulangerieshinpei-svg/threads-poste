# これを .env にコピーして実際の値を入れる（.env は gitignore 済み）

# フェーズ2: AI文案生成
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# フェーズ3: Threads自動投稿
# Meta for Developers の Threads ユースケースで取得した長期アクセストークン
THREADS_ACCESS_TOKEN=THxxxxxxxx
# ThreadsユーザーID（数字）
THREADS_USER_ID=1234567890

# true の間は実投稿せず、投稿内容をログに出すだけ（動作確認用）
# 確認が済んだら false にして再デプロイする
DRY_RUN=true
